{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GMAP",
  "version": "0.1.0",
  "identifier": "com.gmap.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GMAP",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bastien Stefani",
    "copyright": "© 2026 Bastien Stefani",
    "category": "Utility",
    "shortDescription": "Éditeur et créateur de tracés GPX (rando/canoë), online et offline.",
    "longDescription": "GMAP : application desktop d'édition et de création de tracés GPX pour la randonnée et le canoë. Import/export GPX, GeoJSON, KML, TCX, FIT ; édition de traces, points d'intérêt, photos géolocalisées ; fonds IGN/OSM avec cache hors-ligne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"]
      }
    }
  }
}
